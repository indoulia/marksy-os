<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.marksy.os">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Coarse only: city-level weather on the Home greeting card. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MarksyOsApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Marksy OS"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarksyOS">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".notification.WhatsAppSettingsActivity"
            android:exported="true"
            android:label="WhatsApp Connector Settings" />

        <service
            android:name=".notification.MarksyNotificationListenerService"
            android:exported="true"
            android:label="Marksy OS Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".notification.MarksyWhatsAppAccessibilityService"
            android:exported="true"
            android:label="Marksy OS WhatsApp Connector"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/marksy_whatsapp_accessibility_service" />
        </service>

    </application>
</manifest>
