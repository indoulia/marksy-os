<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.marksy.os">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Coarse only: city-level weather on the Home greeting card. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Ask Marksy voice questions, recognised in-app via SpeechRecognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Opt-in Calendar connector: read-only, requested only when the user connects it. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Posts user-set reminders for captured notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Plan: birthdays read from contacts, read-only, requested only when the user taps "Import birthdays". -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Package visibility for "Open in <app>": launcher apps only, not QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Android 11+ hides recognition services unless declared; SpeechRecognizer needs to bind one. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".MarksyOsApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Marksy OS"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarksyOS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".notification.WhatsAppSettingsActivity"
            android:exported="true"
            android:label="WhatsApp Connector Settings" />

        <receiver
            android:name=".notification.ListenerRebindReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Mark done" on a plan reminder notification. -->
        <receiver
            android:name=".notification.PlanDoneReceiver"
            android:exported="false" />

        <service
            android:name=".notification.MarksyNotificationListenerService"
            android:exported="true"
            android:label="Marksy OS Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".notification.MarksyWhatsAppAccessibilityService"
            android:exported="true"
            android:label="Marksy OS WhatsApp Connector"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/marksy_whatsapp_accessibility_service" />
        </service>

    </application>
</manifest>
